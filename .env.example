# Claude API key, used to pick the best moments and write hooks/captions.
# Get one at https://platform.claude.com/ . Without it ClipForge still works, but picks
# moments from audio loudness and scene cuts only and writes generic captions.
ANTHROPIC_API_KEY=

# Only needed when you use an API key instead of `postiz auth:login`.
# POSTIZ_API_KEY=
